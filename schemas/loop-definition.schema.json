{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engineering.local/schemas/loop-definition.schema.json",
  "title": "Loop Definition",
  "description": "Machine-readable contract for one bounded agentic control loop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "risk_level",
    "owner",
    "objective",
    "setpoint",
    "sensor",
    "controller",
    "actuator",
    "verification",
    "flow_control",
    "human_gate",
    "limits",
    "stop_conditions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_level": {
            "enum": [
              "medium",
              "high",
              "critical"
            ]
          }
        },
        "required": [
          "risk_level"
        ]
      },
      "then": {
        "properties": {
          "human_gate": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "draft",
        "shadow",
        "active",
        "paused",
        "retired"
      ]
    },
    "risk_level": {
      "enum": [
        "read_only",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "approver"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "setpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "success_conditions"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10
        },
        "success_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_checks",
        "agent_checks",
        "baseline_file",
        "output_format",
        "stable_sort",
        "on_error"
      ],
      "properties": {
        "deterministic_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agent_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_format": {
          "enum": [
            "json",
            "jsonl",
            "sarif",
            "junit",
            "text"
          ]
        },
        "stable_sort": {
          "type": "string",
          "minLength": 1
        },
        "on_error": {
          "enum": [
            "stop",
            "escalate"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "deterministic_checks": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "agent_checks": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_policy",
        "batch_size",
        "priority_inputs"
      ],
      "properties": {
        "selection_policy": {
          "type": "string",
          "minLength": 10
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "priority_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actuator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_file",
        "golden_patterns",
        "allowed_paths",
        "denied_paths",
        "max_files_changed"
      ],
      "properties": {
        "skill_file": {
          "type": "string",
          "minLength": 1
        },
        "golden_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "denied_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_files_changed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "required_evidence",
        "independent_agent_review"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independent_agent_review": {
          "type": "boolean"
        }
      }
    },
    "flow_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_open_outputs",
        "portfolio_capacity_key",
        "behavior_when_blocked",
        "schedule"
      ],
      "properties": {
        "max_open_outputs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "portfolio_capacity_key": {
          "type": "string",
          "minLength": 1
        },
        "behavior_when_blocked": {
          "enum": [
            "no_op",
            "queue",
            "escalate"
          ]
        },
        "schedule": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "approver",
        "feedback_file",
        "iterate_trigger"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "feedback_file": {
          "type": "string",
          "minLength": 1
        },
        "iterate_trigger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_minutes",
        "max_actuation_attempts",
        "max_diff_lines",
        "max_cost_usd"
      ],
      "properties": {
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "max_actuation_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_diff_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_docs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
